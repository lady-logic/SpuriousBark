# Snowflake connection settings — copy this file to .env and fill in your real values.
# .env is NOT committed (see .gitignore).

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPURIOUS_BARK
SNOWFLAKE_SCHEMA=PUBLIC

# Model for SNOWFLAKE.CORTEX.COMPLETE(), e.g. 'mistral-large2', 'llama3.1-70b', 'snowflake-arctic'
CORTEX_MODEL=mistral-large2
